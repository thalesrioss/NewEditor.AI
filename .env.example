# Chave da API da Anthropic (console.anthropic.com) — usada pelo agente NewEditor.AI
ANTHROPIC_API_KEY=
# Modelo do agente
NEWEDITOR_MODEL=claude-opus-5-5
# Porta do servidor (API + WebSocket)
NEWEDITOR_PORT=4310
# Pasta da produtora (FILA.md e producao/<cliente>/<card>/entrega/): o app abre na galeria com todos os vídeos editados.
# NEWEDITOR_PRODUTORA=/Users/<voce>/newstudios
# App de desktop: abre direto na central da NewStudios (padrão http://localhost:5410, sem servidor próprio);
# só sobe o servidor do app se a central não responder. Vazio ou off desliga a central.
# NEWEDITOR_CENTRAL_URL=http://localhost:5410
